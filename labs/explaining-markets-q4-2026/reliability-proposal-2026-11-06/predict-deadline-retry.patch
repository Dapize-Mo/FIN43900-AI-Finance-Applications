+# Deadline-aware transient retry (Oladapo Olaniyan, Nov 2026). Modal logs showed
+# 32 delivered events lost to Gemini 503 "high demand" and request timeouts with
+# most of the 5-minute budget unused. Attempts alternate primary/fallback with
+# short backoff, each bounded by the time left before the event deadline.
+FALLBACK_MODEL = "gemini-3.1-flash-lite"
+TRANSIENT_STATUS = {429, 500, 502, 503, 504}
+TRANSIENT_NAMES = {"APITimeoutError", "APIConnectionError", "TimeoutException",
+                   "ReadTimeout", "ConnectTimeout", "InternalServerError", "RateLimitError"}
+SAFETY_SECONDS = 25.0        # reserved for submission after the model returns
+MIN_ATTEMPT_SECONDS = 10.0   # do not start a request with less time than this
+ATTEMPT_TIMEOUT_SECONDS = 45.0
+BACKOFF_SECONDS = (0.0, 5.0, 10.0, 20.0, 30.0)
+DEFAULT_SECONDS_LEFT = 240.0  # used only when an event carries no deadline
+_clock = time.monotonic
+_sleep = time.sleep
+
+
+def _seconds_left(deadline: object) -> float:
+    if not isinstance(deadline, str) or not deadline:
+        return DEFAULT_SECONDS_LEFT
+    try:
+        dt = datetime.fromisoformat(deadline.replace("Z", "+00:00"))
+    except ValueError:
+        return DEFAULT_SECONDS_LEFT
+    return (dt - datetime.now(timezone.utc)).total_seconds()
+
+
+def _is_transient(exc: BaseException) -> bool:
+    return getattr(exc, "status_code", None) in TRANSIENT_STATUS or type(exc).__name__ in TRANSIENT_NAMES
+
+
+def _parse_with_budget(primary: str, kwargs: dict, seconds_left: float):
+    """Alternate primary/fallback on transient errors until the deadline budget runs out."""
+    end = _clock() + seconds_left - SAFETY_SECONDS
+    models = [primary] if primary == FALLBACK_MODEL else [primary, FALLBACK_MODEL]
+    attempt, last = 0, None
+    while True:
+        remaining = end - _clock()
+        if remaining < MIN_ATTEMPT_SECONDS:
+            break
+        model = models[attempt % len(models)]
+        client = _openai
+        if hasattr(client, "with_options"):
+            client = client.with_options(timeout=min(ATTEMPT_TIMEOUT_SECONDS, remaining), max_retries=0)
+        try:
+            return client.chat.completions.parse(model=model, **kwargs)
+        except Exception as exc:
+            if not _is_transient(exc):
+                raise
+            last = exc
+            print(f"[WARN] transient {type(exc).__name__} status={getattr(exc, 'status_code', None)} "
+                  f"model={model} attempt={attempt + 1} left={end - _clock():.0f}s", flush=True)
+        pause = BACKOFF_SECONDS[min(attempt, len(BACKOFF_SECONDS) - 1)]
+        attempt += 1
+        if end - _clock() - pause < MIN_ATTEMPT_SECONDS:
+            break
+        if pause:
+            _sleep(pause)
+    if last is not None:
+        raise last
+    raise RuntimeError("no time left for a model request before the prediction deadline")
+
 
